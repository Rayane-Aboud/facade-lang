-- The facade panel of paper Fig. 5, with named and typed inputs.
-- The kinds Thickness and Inset come from prelude/std.fcd.

param base      : Curve
param inset     : Inset     = -1.0 m
param offset    : Length    =  0.0 m
param thickness : Thickness =  0.9 m  where thickness > 0 m

let curve = offset_curve(base, inset)
let surf  = patch(curve)
let mid   = offset_surface(surf, offset)
let panel = thicken(mid, thickness)
let vol   = area(mid) * thickness
